# Copy to .env and fill in local values. Never commit a real .env.

# development | staging | production
# Outside development the application refuses to start with a weak SECRET_KEY
# or with demo-account seeding enabled.
ENVIRONMENT=development

HOST=127.0.0.1
PORT=8000

MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=care_os

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated exact origins. Wildcards are rejected. Include both spellings
# of localhost if the dev server may be reached either way.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory holding the serialized CareAI models.
AI_MODEL_DIR=AI:ML

# Where uploaded files are stored. Relative paths resolve under Backend/.
UPLOAD_DIR=uploads

# Login throttling.
LOGIN_MAX_ATTEMPTS=8
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# Development convenience accounts. Must be false outside development.
# Leave DEMO_USER_PASSWORD blank to have one generated and printed at startup.
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=

# Interactive API docs. Defaults to on in development, off elsewhere.
# ENABLE_API_DOCS=false
